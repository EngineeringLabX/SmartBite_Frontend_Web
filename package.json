{
  "name": "smartbite",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n shell,vendor,kitchen,delivery,admin -c green,blue,yellow,magenta,cyan \"npm run dev -w @smartbite/shell\" \"npm run dev -w @smartbite/vendor\" \"npm run dev -w @smartbite/kitchen\" \"npm run dev -w @smartbite/delivery\" \"npm run dev -w @smartbite/admin\"",
    "dev:shell": "npm run dev -w @smartbite/shell",
    "dev:vendor": "npm run dev -w @smartbite/vendor",
    "dev:kitchen": "npm run dev -w @smartbite/kitchen",
    "dev:delivery": "npm run dev -w @smartbite/delivery",
    "dev:admin": "npm run dev -w @smartbite/admin",
    "build": "npm run build -w @smartbite/vendor -w @smartbite/kitchen -w @smartbite/delivery -w @smartbite/admin && npm run build -w @smartbite/shell",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@module-federation/vite": "^1.23.0",
    "@tanstack/eslint-plugin-query": "^5.104.0",
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.0"
  }
}
